  "query": "\n        SELECT \n            a.ticker as \"ticker!\", \n            a.nombre as \"nombre!\", \n            a.categoria_id::text as \"categoria_id?\", \n            c.nombre as \"categoria_nombre?\",\n            c.color as \"color?\"\n        FROM activos a\n        LEFT JOIN categorias c ON a.categoria_id = c.id\n        ORDER BY a.nombre ASC\n        ",
